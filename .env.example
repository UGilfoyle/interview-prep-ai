# ==============================================================================
# Environment Configuration for InterviewPrep AI
# Copy this file to .env or set these in your Vercel Project Environment Variables
# ==============================================================================

# Google Gemini API Key (Client-side)
VITE_GEMINI_API_KEY=

# Neon Serverless Postgres Database Connection String
# Example: postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Secret for Session Authentication (Generate a random 32+ char string)
JWT_SECRET=your_jwt_secret_key_change_in_production

# (Optional) GitHub OAuth Integration (for 1-click GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# (Optional) LinkedIn OAuth Integration (for 1-click LinkedIn login)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
